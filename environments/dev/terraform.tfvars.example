# Copy to terraform.tfvars and adjust before planning.
# NEVER commit real terraform.tfvars - tfvars.example is the contract
# between the platform team and the environment owner.

region   = "eu-west-1"

# EKS control-plane IAM roles - create once via docs/bootstrap.md, paste ARNs here
cluster_role_arn = "arn:aws:iam::123456789012:role/fleet-dev-cluster"
node_role_arn    = "arn:aws:iam::123456789012:role/fleet-dev-node"

# Leave db_password empty to let the module generate one;
# rotate into Secrets Manager afterwards and remove from state.

instance_class = "db.t4g.small"  # dev sizing - see modules/rds
